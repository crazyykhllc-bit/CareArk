# 复制为 .env 后，为每套部署生成独立的强密码；不要提交 .env。
POSTGRES_PASSWORD=
S3_ACCESS_KEY=healtharchive
S3_SECRET_KEY=
S3_BUCKET=health-archive

# 首选示例：DeepSeek 官方 API；需要支持图片输入的模型
# 使用其他模型服务时，请同时修改基础地址、模型名称和 API Key。
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_NAME=deepseek-flash
# 可选备用服务：三项都填后，主服务限流、额度耗尽或暂时不可用时自动切换
MODEL_FALLBACK_BASE_URL=
MODEL_FALLBACK_API_KEY=
MODEL_FALLBACK_NAME=

# 第二备用：主服务与第一备用暂时不可用时再使用
MODEL_FALLBACK2_BASE_URL=
MODEL_FALLBACK2_API_KEY=
MODEL_FALLBACK2_NAME=
MODEL_FALLBACK2_STRICT_JSON_SCHEMA=false

# DeepSeek 使用 JSON Object；更换服务商时按其接口能力调整
MODEL_STRICT_JSON_SCHEMA=false
MODEL_TIMEOUT_SECONDS=600
MODEL_MAX_RETRIES=3
MODEL_MAX_PAGES=30
MODEL_IMAGE_DETAIL=high
MODEL_STREAM_RESPONSES=true
# 超过此来源数量，先统一规划分组，再逐份输出结构化结果
MODEL_MERGE_MAX_SOURCES_PER_REQUEST=5
MODEL_MAX_SOURCES_PER_REQUEST=1
MODEL_BATCH_CONCURRENCY=2
MODEL_CHUNK_MAX_OUTPUT_TOKENS=4000

# 混合批次：文件数、原件总大小和联合请求大小（字节）
BATCH_MAX_FILES=20
BATCH_MAX_BYTES=104857600
MODEL_MAX_REQUEST_BYTES=41943040
MODEL_MAX_OUTPUT_TOKENS=16000
# 兼容接口使用 max_tokens 或 max_completion_tokens；留空则不发送该参数
MODEL_OUTPUT_TOKEN_PARAMETER=max_tokens

# 本地 HTTP 使用 false；正式 HTTPS 部署必须改为 true
SECURE_COOKIES=false
UPLOAD_MAX_BYTES=26214400
